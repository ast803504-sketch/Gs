-- 3. نظام التختيم الذكي (Auto Farm / Fly Walk)
-- ================= ================= =================

local AutoFarmActive = false

-- تفعيل النوكليب وإلغاء التصادم مع الحيوانات والعقبات
local function EnableGodMode()
    if LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end

-- دالة التختيم التلقائي بالتحليق الذكي
CreateButton("🤖 تفعيل التختيم التلقائي الذكي (Auto Farm)", Color3.fromRGB(0, 170, 100), function()
    AutoFarmActive = not AutoFarmActive
    
    if AutoFarmActive then
        task.spawn(function()
            while AutoFarmActive do
                EnableGodMode()
                
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    
                    -- البحث عن نقاط الكيبورد/الأزرار/الترتيب
                    local stages = Workspace:FindFirstChild("Stages") or Workspace:FindFirstChild("Buttons") or Workspace:FindFirstChild("Keyboard") or Workspace
                    local targets = {}
                    
                    for _, child in pairs(stages:GetChildren()) do
                        if child:IsA("BasePart") or child:IsA("Model") then
                            table.insert(targets, child)
                        end
                    end
                    
                    -- التحريك الفخم المرتفع فوق الأرض لتفادي الحيوانات والسرعة الفائقة
                    for _, target in ipairs(targets) do
                        if not AutoFarmActive then break end
                        
                        local targetCFrame = target:IsA("Model") and target:GetPrimaryPartCFrame() or target.CFrame
                        if targetCFrame then
                            -- ارتفاع 5 أمتار عن الأرض لعدم لمس الأعداء
                            local safeCFrame = targetCFrame + Vector3.new(0, 5, 0)
                            
                            -- سلاسة الحركة والالتفات تلقائياً للنقطة التالية
                            local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Linear)
                            local tween = TweenService:Create(hrp, tweenInfo, {CFrame = safeCFrame})
                            tween:Play()
                            tween.Completed:Wait()
                        end
                    end
                end
                task.wait(0.5)
            end
        end)
    end
end)

-- خيار إيقاف التختيم الذكي
